{
  "name": "plyth-core",
  "version": "0.1.2",
  "description": "Local-first outcome tracking and experimental feedback for coding agents.",
  "license": "MIT",
  "author": "Wendell Balagot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamwendellbalagot/plyth.git"
  },
  "homepage": "https://github.com/iamwendellbalagot/plyth#readme",
  "bugs": {
    "url": "https://github.com/iamwendellbalagot/plyth/issues"
  },
  "keywords": [
    "coding-agents",
    "developer-tools",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "plyth-core": "bin/plyth.mjs"
  },
  "files": [
    "dist",
    "docs",
    "bin/plyth.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
